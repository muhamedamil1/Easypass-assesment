        "server-only": "^0.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^17.4.2",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "tsx": "^4.23.0",
        "typescript": "^5",
        "vitest": "^4.1.10"
    }
